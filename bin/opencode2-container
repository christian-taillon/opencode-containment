#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd -P)"

echo "Warning: $(basename "$0") is a compatibility alias. opencode-containment now follows ghcr.io/anomalyco/opencode:latest through opencode-container." >&2
exec "$SCRIPT_DIR/opencode-container" "$@"
